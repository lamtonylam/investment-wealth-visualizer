# Optional: Live price endpoint for one Jaloviina bottle.
# Must return JSON: { "price": "21.38" }
# Fetched server-side by the Next.js /api/jaloviina-price API route to eliminate CORS issues.
# If not set, falls back to https://alko.tonylam.iki.fi/ or the default hardcoded price (20.60 €).
JALOVIINA_PRICE_URL=https://alko.tonylam.iki.fi/
